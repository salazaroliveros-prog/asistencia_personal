rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────────
    // FUNCIONES DE AYUDA - AUTENTICACIÓN Y ROLES
    // ─────────────────────────────────────────────────────────────────────────
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }
    
    function isManager() {
      return isAuthenticated() && request.auth.token.manager == true;
    }
    
    function isSupervisor() {
      return isAuthenticated() && request.auth.token.supervisor == true;
    }
    
    function isEmployee() {
      return isAuthenticated() && request.auth.token.employee == true;
    }
    
    function isAuthorizedOperator() {
      return isAuthenticated() &&
               request.auth.token.email_verified == true &&
               request.auth.token.email == 'sistemadecontrol090@gmail.com';
    }
    
    function canManageWorkers() {
      return isAdmin() || isManager();
    }
    
    function canMarkAttendance() {
      // Las marcaciones son una operación privilegiada. Una sesión anónima o
      // cualquier usuario autenticado no debe poder suplantar al operador.
      return isAuthorizedOperator() || isAdmin() || isManager() || isSupervisor();
    }
    
    function getUserId() {
      return request.auth.uid;
    }
    
    // ─────────────────────────────────────────────────────────────────────────
    // FUNCIONES DE VALIDACIÓN DE DATOS
    // ─────────────────────────────────────────────────────────────────────────
    
    function isValidString(value, min, max) {
      return value is string && value.length >= min && value.length <= max;
    }
    
    function isValidNumber(value, min, max) {
      return value is number && value >= min && value <= max;
    }
    
    function isValidTimestamp(value) {
      return value is number && value > 0;
    }

    function isValidDateValue(value) {
      return value is timestamp ||
        (value is number && value > 0) ||
        (value is string && value.length >= 20 && value.length <= 30);
    }
    
    function isValidArray(value, minLength) {
      return value is list && value.size() >= minLength;
    }
    
    function isValidMap(value, requiredKeys) {
      return value is map && value.keys().hasAll(requiredKeys);
    }
    
    function isValidWorkerData(data) {
      return data.keys().hasAll([
        'ID_Trabajador', 'Nombre_Completo', 'DPI_CUI', 'Puesto', 'Estado',
        'Fecha_Registro', 'Telefono', 'WhatsApp', 'Direccion'
      ]) &&
        isValidString(data.ID_Trabajador, 1, 50) &&
        isValidString(data.Nombre_Completo, 2, 100) &&
        isValidString(data.DPI_CUI, 10, 20) &&
        isValidString(data.Puesto, 2, 50) &&
        isValidString(data.Telefono, 0, 20) &&
        isValidString(data.WhatsApp, 0, 20) &&
        isValidString(data.Direccion, 0, 200) &&
        data.Estado in ['Activo', 'Inactivo', 'Eliminado', 'Suspendido'] &&
        isValidDateValue(data.Fecha_Registro);
    }
    
    function isValidAttendanceData(data) {
      return data.keys().hasAll([
        'ID_Marcacion', 'ID_Registro', 'ID_Trabajador', 'Nombre_Trabajador', 
        'Fecha', 'Tipo_Marcacion', 'Hora_Real', 'Estado_Marcacion', 'Timestamp'
      ]) &&
        isValidString(data.ID_Marcacion, 1, 50) &&
        isValidString(data.ID_Registro, 1, 50) &&
        isValidString(data.ID_Trabajador, 1, 50) &&
        isValidString(data.Nombre_Trabajador, 2, 100) &&
        isValidString(data.Fecha, 10, 10) &&
        data.Tipo_Marcacion in ['Entrada', 'Salida_Receso', 'Regreso_Receso', 'Salida_Obra', 'Entrada_Extra'] &&
        isValidString(data.Hora_Real, 5, 8) &&
        data.Estado_Marcacion in ['A Tiempo', 'Puntual', 'Tolerancia', 'Atraso', 'Ausencia'] &&
        isValidTimestamp(data.Timestamp);
    }
    
    function isValidConfiguracion(data) {
      return data.keys().hasAll(['Nombre_Obra', 'Encargado', 'Tolerancia_Minutos']) &&
        isValidString(data.Nombre_Obra, 1, 100) &&
        isValidString(data.Encargado, 1, 100) &&
        isValidNumber(data.Tolerancia_Minutos, 0, 120);
    }
    
    function isValidDepartamento(data) {
      return data.keys().hasAll(['nombre', 'descripcion', 'activo']) &&
        isValidString(data.nombre, 2, 50) &&
        isValidString(data.descripcion, 0, 200) &&
        data.activo is bool;
    }
    
    function isValidProyecto(data) {
      return data.keys().hasAll(['nombre', 'descripcion', 'direccion', 'activo', 'fechaInicio']) &&
        isValidString(data.nombre, 2, 100) &&
        isValidString(data.descripcion, 0, 500) &&
        isValidString(data.direccion, 5, 200) &&
        data.activo is bool &&
        isValidTimestamp(data.fechaInicio);
    }
    
    function isValidRol(data) {
      return data.keys().hasAll(['nombre', 'descripcion', 'permisos', 'activo']) &&
        isValidString(data.nombre, 2, 50) &&
        isValidString(data.descripcion, 0, 200) &&
        isValidArray(data.permisos, 1) &&
        data.activo is bool;
    }
    
    function isValidAlerta(data) {
      return data.keys().hasAll(['tipo', 'mensaje', 'timestamp', 'revisada']) &&
        isValidString(data.tipo, 1, 50) &&
        isValidString(data.mensaje, 1, 500) &&
        isValidTimestamp(data.timestamp) &&
        data.revisada is bool;
    }
    
    function isValidLog(data) {
      return data.keys().hasAll(['accion', 'coleccion', 'documentoId', 'usuarioId', 'email', 'timestamp', 'detalles']) &&
        isValidString(data.accion, 1, 50) &&
        isValidString(data.coleccion, 1, 50) &&
        isValidString(data.documentoId, 1, 100) &&
        isValidString(data.usuarioId, 1, 128) &&
        isValidString(data.email, 3, 254) &&
        isValidTimestamp(data.timestamp) &&
        isValidMap(data.detalles, []);
    }
    
    // ─────────────────────────────────────────────────────────────────────────
    // COLECCIÓN: USUARIOS (Perfiles vinculados a Firebase Auth)
    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Reglas deny explícitas para seguridad
      deny: if !isAuthenticated();
      deny: if request.method == 'read' && 
              userId != getUserId() && 
              !isAdmin() && 
              !isManager();
      deny: if request.method == 'create' && !isAdmin();
      deny: if request.method == 'create' && 
              isAdmin() && 
              request.resource.data.uid != getUserId();
      deny: if request.method == 'update' && 
              !isAdmin() && 
              userId != getUserId();
      deny: if request.method == 'update' && 
              userId == getUserId() && 
              !request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['telefono', 'whatsapp', 'direccion', 'fotografiaUrl']);
      deny: if request.method == 'delete' && !isAdmin();
      
      // Reglas allow positivas
      allow read: if isAuthenticated() && 
        (userId == getUserId() || isAdmin() || isManager());
      
      allow create: if isAdmin() && 
        request.resource.data.keys().hasAll(['uid', 'email', 'rol', 'activo']) &&
        request.resource.data.uid == getUserId() &&
        isValidString(request.resource.data.email, 3, 254);
      
      allow update: if isAdmin() ||
        (userId == getUserId() && 
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['telefono', 'whatsapp', 'direccion', 'fotografiaUrl']) &&
         request.resource.data.keys().size() <= 10);
      
      allow delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────────────────
    // COLECCIÓN: ROLES (Definiciones de roles y permisos)
    // ─────────────────────────────────────────────────────────────────────────
    match /roles/{roleId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() && isValidRol(request.resource.data);
    }
    
    // ─────────────────────────────────────────────────────────────────────────
    // COLECCIÓN: DEPARTAMENTOS
    // ─────────────────────────────────────────────────────────────────────────
    match /departamentos/{deptId} {
      allow read: if isAuthenticated();
      allow create, update: if canManageWorkers() && isValidDepartamento(request.resource.data);
      allow delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────────────────
    // COLECCIÓN: PROYECTOS/OBRAS
    // ─────────────────────────────────────────────────────────────────────────
    match /proyectos/{proyectoId} {
      allow read: if isAuthenticated();
      allow create, update: if canManageWorkers() && isValidProyecto(request.resource.data);
      allow delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────────────────
    // COLECCIÓN: PERSONAL (Trabajadores)
    // ─────────────────────────────────────────────────────────────────────────
    match /personal/{workerId} {
      // Reglas deny explícitas para seguridad
      deny: if !isAuthenticated();
      deny: if request.method == 'create' && !canManageWorkers();
      deny: if request.method == 'create' && 
              canManageWorkers() && 
              !isValidWorkerData(request.resource.data);
      deny: if request.method == 'update' && !canManageWorkers();
      deny: if request.method == 'update' && 
              canManageWorkers() && 
              !isValidWorkerData(request.resource.data);
      deny: if request.method == 'update' && 
              canManageWorkers() && 
              !request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly([
                  'Nombre_Completo', 'DPI_CUI', 'Puesto', 'Jefe_Inmediato',
                  'Telefono', 'WhatsApp', 'Direccion', 'Fotografia_URL', 
                  'Estado', 'departamentoId', 'proyectoId', 'fechaBaja', 'motivoBaja'
                ]);
      deny: if request.method == 'delete' && !isAdmin();
      
      // Reglas allow positivas
      allow read: if isAuthenticated();
      
      allow create: if canManageWorkers() && 
        isValidWorkerData(request.resource.data) &&
        request.resource.data.keys().size() <= 20;
      
      allow update: if canManageWorkers() &&
        isValidWorkerData(request.resource.data) &&
        request.resource.data.keys().size() <= 20 &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'Nombre_Completo', 'DPI_CUI', 'Puesto', 'Jefe_Inmediato',
            'Telefono', 'WhatsApp', 'Direccion', 'Fotografia_URL', 
            'Estado', 'departamentoId', 'proyectoId', 'fechaBaja', 'motivoBaja'
          ]);
      
      allow delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────────────────
    // COLECCIÓN: ASISTENCIAS (Registros de marcación)
    // ─────────────────────────────────────────────────────────────────────────
    match /asistencias/{attendanceId} {
      // Reglas deny explícitas para seguridad
      deny: if !isAuthenticated();
      deny: if request.method == 'create' && !canMarkAttendance();
      deny: if request.method == 'create' && 
              canMarkAttendance() && 
              !isValidAttendanceData(request.resource.data);
      deny: if request.method == 'update' && !canManageWorkers();
      deny: if request.method == 'update' && 
              canManageWorkers() && 
              !isValidAttendanceData(request.resource.data);
      deny: if request.method == 'update' && 
              canManageWorkers() && 
              !request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['Hora_Real', 'Estado_Marcacion', 'Horas_Extra', 'observaciones', 'corregidoPor', 'corregidoEn']);
      deny: if request.method == 'delete' && !isAdmin();
      
      // Reglas allow positivas
      allow read: if isAuthenticated();
      
      allow create: if canMarkAttendance() &&
        isValidAttendanceData(request.resource.data) &&
        request.resource.data.keys().size() <= 25;
      
      allow update: if canManageWorkers() &&
        isValidAttendanceData(request.resource.data) &&
        request.resource.data.keys().size() <= 25 &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['Hora_Real', 'Estado_Marcacion', 'Horas_Extra', 'observaciones', 'corregidoPor', 'corregidoEn']);
      
      allow delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────────────────
    // COLECCIÓN: CONFIGURACIÓN (Configuración global del sistema)
    // ─────────────────────────────────────────────────────────────────────────
    match /configuracion/{configId} {
      // Reglas deny explícitas para seguridad
      deny: if !isAuthenticated();
      deny: if request.method == 'create' && !isAdmin();
      deny: if request.method == 'create' && 
              isAdmin() && 
              !isValidConfiguracion(request.resource.data);
      deny: if request.method == 'update' && !isAdmin();
      deny: if request.method == 'update' && 
              isAdmin() && 
              !isValidConfiguracion(request.resource.data);
      deny: if request.method == 'delete' && !isAdmin();
      
      // Reglas allow positivas
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() && isValidConfiguracion(request.resource.data);
      allow delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────────────────
    // COLECCIÓN: ALERTAS (Notificaciones y alertas del sistema)
    // ─────────────────────────────────────────────────────────────────────────
    match /alertas/{alertId} {
      allow read: if isAuthenticated();
      allow create: if canManageWorkers() && 
        request.resource.data.keys().size() <= 15 &&
        isValidAlerta(request.resource.data);
      allow update: if isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['Revisada']) &&
        request.resource.data.Revisada == true;
      allow delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────────────────
    // COLECCIÓN: NOTIFICACIONES (Notificaciones push/email por usuario)
    // ─────────────────────────────────────────────────────────────────────────
    match /notificaciones/{notifId} {
      allow read: if isAuthenticated() && 
        (resource.data.usuarioId == getUserId() || isAdmin());
      allow create: if canManageWorkers() &&
        request.resource.data.usuarioId != null &&
        isValidString(request.resource.data.titulo, 1, 100) &&
        isValidString(request.resource.data.mensaje, 1, 500);
      allow update: if isAuthenticated() &&
        resource.data.usuarioId == getUserId() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['leida', 'fechaLectura']) &&
        request.resource.data.leida == true;
      allow delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────────────────
    // COLECCIÓN: LOGS (Registro de auditoría inmutable)
    // ─────────────────────────────────────────────────────────────────────────
    match /logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && 
        request.resource.data.usuarioId == getUserId() &&
        isValidLog(request.resource.data);
      allow update, delete: if false;
    }
    
    // ─────────────────────────────────────────────────────────────────────────
    // COLECCIÓN: HEALTH (Para health checks)
    // ─────────────────────────────────────────────────────────────────────────
    match /health/{healthId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() && request.resource.data.keys().size() <= 10;
    }
  }
}
