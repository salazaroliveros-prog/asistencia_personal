rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ─────────────────────────────────────────────────────────────────────────
    // FUNCIONES DE AYUDA
    // ─────────────────────────────────────────────────────────────────────────
    
    // Verifica si el usuario es administrador mediante custom claims.
    // Requiere Cloud Functions para establecer claims (setAdminClaim).
    // Si no hay claim admin, se niega el acceso de escritura/eliminación.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Plan gratuito: la cuenta operadora se fija en reglas, no en datos que
    // pueda modificar el cliente. Solo funciona con correo de Google verificado.
    function isAuthorizedOperator() {
      return request.auth != null &&
             request.auth.token.email_verified == true &&
             request.auth.token.email == 'sistemadecontrol090@gmail.com';
    }
    
    // Valida que un string no esté vacío y tenga longitud razonable
    function isValidString(value, min, max) {
      return value is string && value.length >= min && value.length <= max;
    }
    
    // Valida estructura básica de trabajador (sobre el documento resultante)
    function isValidWorkerData(data) {
      return data.keys().hasAll(['ID_Trabajador', 'Nombre_Completo', 'DPI_CUI', 'Puesto', 'Estado']) &&
             isValidString(data.ID_Trabajador, 1, 50) &&
             isValidString(data.Nombre_Completo, 2, 100) &&
             isValidString(data.DPI_CUI, 10, 20) &&
             isValidString(data.Puesto, 2, 50) &&
             data.Estado in ['Activo', 'Inactivo', 'Eliminado'];
    }
    
    // Valida estructura básica de asistencia (sobre el documento resultante)
    function isValidAttendanceData(data) {
      return data.keys().hasAll(['ID_Marcacion', 'ID_Trabajador', 'Nombre_Trabajador', 'Fecha', 'Tipo_Marcacion', 'Hora_Real', 'Estado_Marcacion']) &&
             isValidString(data.ID_Marcacion, 1, 50) &&
             isValidString(data.ID_Trabajador, 1, 50) &&
             isValidString(data.Nombre_Trabajador, 2, 100) &&
             isValidString(data.Fecha, 10, 10) &&
             data.Tipo_Marcacion in ['Entrada', 'Salida_Receso', 'Regreso_Receso', 'Salida_Obra'] &&
             isValidString(data.Hora_Real, 5, 8) &&
             data.Estado_Marcacion in ['A Tiempo', 'Puntual', 'Tolerancia', 'Atraso', 'Ausencia'];
    }
    
    // ─────────────────────────────────────────────────────────────────────────
    // COLECCIÓN: PERSONAL
    // ─────────────────────────────────────────────────────────────────────────
    match /personal/{workerId} {
      // Cualquier usuario autenticado puede leer trabajadores
      allow read: if request.auth != null;
      
      // Solo administradores pueden crear trabajadores
      allow create: if isAdmin() && 
                     isValidWorkerData(request.resource.data) &&
                     request.resource.data.keys().size() <= 15;
      
      // Solo administradores pueden actualizar.
      // Se valida el documento resultante completo (request.resource.data)
      // y que los campos modificados sean solo los permitidos.
      allow update: if isAdmin() &&
                    isValidWorkerData(request.resource.data) &&
                    request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['Nombre_Completo', 'DPI_CUI', 'Puesto', 'Jefe_Inmediato',
                               'Telefono', 'WhatsApp', 'Direccion', 'Fotografia_URL', 'Estado']) &&
                    request.resource.data.keys().size() <= 15;
      
      // Solo administradores pueden eliminar (baja física)
      allow delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────────────────
    // COLECCIÓN: ASISTENCIAS
    // ─────────────────────────────────────────────────────────────────────────
    match /asistencias/{attendanceId} {
      // Cualquier usuario autenticado puede leer asistencias
      allow read: if request.auth != null;
      
      // La marcación la realiza exclusivamente el operador verificado.
      allow create: if isAuthorizedOperator() &&
                     isValidAttendanceData(request.resource.data) &&
                     request.resource.data.keys().size() <= 20;
      
      // Solo administradores pueden actualizar asistencias.
      // Se valida el documento resultante completo y que los campos
      // efectivamente modificados sean solo los 3 editables.
      allow update: if isAdmin() &&
                    isValidAttendanceData(request.resource.data) &&
                    request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['Hora_Real', 'Estado_Marcacion', 'Horas_Extra']) &&
                    request.resource.data.keys().size() <= 20;
      
      // Solo administradores pueden eliminar asistencias
      allow delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────────────────
    // COLECCIÓN: CONFIGURACIÓN
    // ─────────────────────────────────────────────────────────────────────────
    match /configuracion/{configId} {
      // Cualquier usuario autenticado puede leer la configuración
      // (necesario para que operadores y supervisores carguen horarios y GPS)
      allow read: if request.auth != null;
      allow create, update: if isAdmin() &&
                               request.resource.data.keys().size() <= 30;
      allow delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────────────────
    // COLECCIÓN: ALERTAS
    // ─────────────────────────────────────────────────────────────────────────
    match /alertas/{alertId} {
      // Cualquier usuario autenticado puede leer alertas
      allow read: if request.auth != null;
      
      // Solo administradores pueden crear alertas
      allow create: if isAdmin() &&
                     request.resource.data.keys().size() <= 15;
      
      // Cualquier usuario puede marcar alerta como revisada
      allow update: if request.auth != null &&
                    request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['Revisada']) &&
                    request.resource.data.Revisada == true;
      
      // Solo administradores pueden eliminar alertas
      allow delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────────────────
    // COLECCIÓN: HEALTH (para health checks)
    // ─────────────────────────────────────────────────────────────────────────
    match /health/{healthId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() &&
                   request.resource.data.keys().size() <= 10;
    }
  }
}
