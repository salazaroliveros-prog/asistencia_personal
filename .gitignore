# ══════════════════════════════════════════════════════════════════
# .gitignore — Control Asistencia App
# ══════════════════════════════════════════════════════════════════

# ── Variables de entorno (NUNCA al repositorio) ──────────────────
.env
.env.local
.env.*.local
credencialesgoogle.txt

# ── Dependencias ─────────────────────────────────────────────────
node_modules/
functions/node_modules/
.qa-deps/

# ── Build / dist ─────────────────────────────────────────────────
dist/

# ── Vercel ───────────────────────────────────────────────────────
.vercel/

# ── Firebase local ───────────────────────────────────────────────
.firebase/
firebase-debug.log
firestore-debug.log
.firebaserc

# ── Firebase Data Connect (generado localmente) ──────────────────
dataconnect/
src/dataconnect-generated/
ios/FirebaseDataConnectGenerated/

# ── Tooling de agentes (solo local, no es código del producto) ───
.agents/
.claude/
.kilo/
skills-lock.json

# ── IDE / Editor ─────────────────────────────────────────────────
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Capacitor / Plataformas nativas ──────────────────────────────
android/
ios/
app-movil/

# ── Playwright (navegadores y reportes locales) ──────────────────
.playwright-browsers/
.playwright-mcp/
playwright-report/

# ── Logs ─────────────────────────────────────────────────────────
*.log
preview.log
_browsers_install.log

# ── QA / Tests temporales ─────────────────────────────────────────
__tests__/screenshots/
__tests__/results/
__tests__/_qa_state.json
__tests__/_apply_fix.mjs
__tests__/_marker.cmd
__tests__/_netcheck.mjs
__tests__/_pw_install.cmd
__tests__/_pwcheck.mjs
__tests__/_trylaunch.mjs
__tests__/_qa_*.mjs
__tests__/_qa_*.cmd
__tests__/_commitmsg.txt
__tests__/_timing.log
__tests__/p*.log
__tests__/e2e-qa-test.js.orig
__tests__/console-tests.js
__tests__/diag-*.js
__tests__/diagnose-*.js
__tests__/e2e-*.js
__tests__/e2e-*.mjs
__tests__/firebase-diagnostic.mjs
__tests__/headless-test.js
__tests__/run-tests.js
__tests__/server.js
__tests__/take-screenshots.js
__tests__/verify-*.js
__tests__/check-*.js
